worker_processes auto;

events {
    worker_connections 1024;
}

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;
    sendfile      on;

    # websocket upgrade passthrough + brute-force throttle for the hidden panel
    map $http_upgrade $connection_upgrade { default upgrade; "" close; }
    limit_req_zone $binary_remote_addr zone=panel:10m rate=10r/s;

    server {
        listen 80;
        server_name __DOMAIN__;
        return 301 https://$host$request_uri;
    }

    server {
        listen 8443 ssl;
        server_name __DOMAIN__;

        ssl_certificate     /etc/letsencrypt/live/__DOMAIN__/fullchain.pem;
        ssl_certificate_key /etc/letsencrypt/live/__DOMAIN__/privkey.pem;
        ssl_protocols       TLSv1.2 TLSv1.3;

        root /var/www/html;
        index index.html;

        # Hidden telemt_panel: secret base_path -> bridge service, behind basic-auth.
        # A guessed path returns a generic 401, never the panel's fingerprint.
        # resolver + variable upstream so nginx starts even if the panel is briefly down.
        location = __PANEL_PATH__ { return 301 __PANEL_PATH__/; }
        location __PANEL_PATH__/ {
            auth_basic           "Restricted";
            auth_basic_user_file /etc/nginx/.htpasswd;
            limit_req            zone=panel burst=20 nodelay;
            resolver             127.0.0.11 valid=30s;
            set $panel_upstream  http://telemt-panel:8080;
            proxy_pass           $panel_upstream;
            proxy_http_version   1.1;
            proxy_set_header     Host $host;
            proxy_set_header     X-Real-IP $remote_addr;
            proxy_set_header     X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header     X-Forwarded-Proto https;
            proxy_set_header     Upgrade $http_upgrade;
            proxy_set_header     Connection $connection_upgrade;
            proxy_read_timeout   3600s;
            proxy_send_timeout   3600s;
        }

        location / {
            try_files $uri $uri/ =404;
        }
    }
}
