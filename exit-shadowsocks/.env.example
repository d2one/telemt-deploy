# Copy to .env and fill in. Method/password/host/port must match the SS_URL in the
# chained instance env (instances/<host>.env).
SS_METHOD=aes-256-gcm
SS_PASSWORD=<32+ char secret, e.g. openssl rand -hex 16>
SS_PORT=<exit port, e.g. a random high port>
# Public IP of the front (chained) server allowed to reach this exit port:
ALLOW_IP=<chained-server-ip>
