# Per-host config — every secret/real value lives here. Copy instances/example.env
# to instances/<name>.env and fill it in; never commit a real instance file.
instances/*.env
!instances/example.env

# Configs generated by deploy/render.sh from instances/*.env (telemt.toml,
# nginx.conf, panel.toml, .htpasswd, regru.ini) — never committed.
deploy/.generated/

# Shadowsocks exit key (deployed on the direct host)
exit-shadowsocks/.env

# Editor / local tooling
.vscode/
.claude/
.idea

# Masking storefront (may carry your brand) — ship the generic .example only
deploy/nginx/html/index.html
