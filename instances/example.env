# ============================================================================
# Instance config — ONE file per host, holds EVERY per-host value and secret.
# Copy to instances/<name>.env (gitignored), fill in, then:  make up HOST=<name>
# `render.sh` turns this into deploy/.generated/<name>/{telemt.toml, nginx.conf,
# panel.toml, .htpasswd, regru.ini}. Never edit the generated files.
#
# NOTE: keep the bcrypt/apr1 hashes in SINGLE quotes — they contain `$`, which the
# shell would otherwise expand when this file is sourced.
# ============================================================================

# --- identity ---------------------------------------------------------------
DOMAIN=proxy.example.com
EGRESS=direct                       # "direct" (reaches Telegram itself) | "chained"
TELEMT_VERSION=3.4.18               # telemt/telemt release tag
PANEL_VERSION=v0.6.0                # amirotin/telemt_panel release tag
# TELEMT_HOLD=1                     # uncomment to pin TELEMT_VERSION (skip auto-update)

# --- proxy users: space-separated  name:secret  (secret = 32 hex chars) -----
#     generate a secret with:  openssl rand -hex 16
USERS="alice:00000000000000000000000000000000 bob:11111111111111111111111111111111"

# --- telemt HTTP API token (panel uses the same value) ----------------------
#     openssl rand -hex 24
API_TOKEN=CHANGE_ME_API_TOKEN

# --- Shadowsocks upstream (EGRESS=chained only) -----------------------------
#     full ss:// URL of the direct host's exit; must match exit-shadowsocks/.env
SS_URL=ss://aes-256-gcm:CHANGE_ME_SS_PASSWORD@CHANGE_ME_DIRECT_HOST_IP:CHANGE_ME_SS_PORT

# --- admin panel ------------------------------------------------------------
PANEL_BASE_PATH=/CHANGE_ME_RANDOM_PATH                 # openssl rand -hex 11  (with leading /)
PANEL_ADMIN_USER=admin
#   printf '%s' 'YOURPASS' | docker run --rm -i --entrypoint sh telemt-panel:<ver> -c 'cat | telemt-panel hash-password'
PANEL_ADMIN_PASS_HASH='$2a$10$CHANGE_ME_BCRYPT_HASH'
PANEL_JWT_SECRET=CHANGE_ME_AT_LEAST_32_RANDOM_CHARS    # openssl rand -hex 32
PANEL_BASIC_USER=ops
#   htpasswd -nbB ops 'BASICPASS'   (then take the part AFTER "ops:")  — or openssl passwd -apr1 'BASICPASS'
PANEL_BASIC_PASS_HASH='$apr1$CHANGE_ME_APR1_HASH'

# --- certbot / reg.ru DNS-01 ------------------------------------------------
CERT_EMAIL=admin@proxy.example.com
REGRU_USER=your-regru-account-email
REGRU_PASS=your-regru-api-password
